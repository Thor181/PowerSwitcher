<Window x:Class="PowerSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerSwitcher.App"
        Title="PowerSwitcher"
        Width="360"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True">

    <!-- Убираем заголовок: окно целиком — «стекло», на которое DWM кладёт акрил -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource FlyoutFallbackBackground}">
        <Grid x:Name="RootGrid">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== Главная страница: плитки профилей ========== -->
            <ScrollViewer x:Name="MainPage" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform/>
                </ScrollViewer.RenderTransform>
                <ItemsControl x:Name="TilesList" Margin="18,24,18,12" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <!-- Плитка профиля: слева — применить, справа — настроить -->
                        <DataTemplate DataType="{x:Type local:ProfileTile}">
                            <StackPanel Width="96" Margin="6,0,6,12">
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource TileButton}"
                                            local:Fluent.CornerRadius="4,0,0,4"
                                            local:Fluent.IsActive="{Binding IsCurrent}"
                                            ToolTip="Применить профиль"
                                            Click="ProfileTile_Click">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE945;"/>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource TileButton}"
                                            local:Fluent.CornerRadius="0,4,4,0"
                                            local:Fluent.IsActive="{Binding IsCurrent}"
                                            ToolTip="Настроить профиль"
                                            Click="ProfileTileEdit_Click">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="12"/>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type local:AddTile}">
                            <StackPanel Width="96" Margin="6,0,6,12">
                                <Button Height="48"
                                        Style="{StaticResource TileButton}"
                                        ToolTip="Новый профиль из текущих настроек"
                                        Click="AddTile_Click">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;"/>
                                </Button>
                                <TextBlock Text="Добавить"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>

            <!-- ========== Страница настройки профиля ========== -->
            <ScrollViewer x:Name="EditPage" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform/>
                </ScrollViewer.RenderTransform>
                <StackPanel Margin="24,16,24,20">
                    <Grid Margin="-8,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SubtleButton}" ToolTip="Назад" Click="Back_Click">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" FontSize="12"/>
                        </Button>
                        <TextBlock Grid.Column="1" x:Name="EditTitle" Style="{StaticResource TitleText}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Экран -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Экран" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Монитор"/>
                    <ComboBox x:Name="DisplayCombo" Style="{StaticResource FluentComboBox}" SelectionChanged="DisplayCombo_SelectionChanged"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Частота обновления, Гц"/>
                    <ComboBox x:Name="RefreshRateCombo" Style="{StaticResource FluentComboBox}" SelectionChanged="RefreshRateCombo_SelectionChanged"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Яркость"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE706;"/>
                        <Slider Grid.Column="1"
                                x:Name="BrightnessSlider"
                                Style="{StaticResource FluentSlider}"
                                Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="10"
                                Margin="12,0"
                                ValueChanged="BrightnessSlider_ValueChanged"/>
                        <TextBlock Grid.Column="2" x:Name="BrightnessValueLabel" Style="{StaticResource BodyText}" Text="—" Width="40" TextAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyText}" Text="Адаптивная яркость"/>
                        <CheckBox Grid.Column="1"
                                  x:Name="AdaptiveBrightnessCheckBox"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="AdaptiveBrightnessCheckBox_Changed"
                                  Unchecked="AdaptiveBrightnessCheckBox_Changed"/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Отключать экран через"/>
                    <ComboBox x:Name="DisplayOffCombo" Style="{StaticResource FluentComboBox}"/>

                    <!-- Питание -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Питание"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Схема питания"/>
                    <ComboBox x:Name="SchemeCombo" Style="{StaticResource FluentComboBox}" SelectionChanged="SchemeCombo_SelectionChanged"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Режим питания"/>
                    <ComboBox x:Name="PowerModeCombo" Style="{StaticResource FluentComboBox}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Text="Действует только со схемой «Сбалансированная»." Margin="0,4,0,0"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyText}" Text="Экономия заряда"/>
                        <CheckBox Grid.Column="1"
                                  x:Name="EnergySaverCheckBox"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="EnergySaverCheckBox_Changed"
                                  Unchecked="EnergySaverCheckBox_Changed"/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Переходить в сон через"/>
                    <ComboBox x:Name="SleepCombo" Style="{StaticResource FluentComboBox}"/>

                    <!-- Процессор -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Процессор"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Turbo Boost"/>
                    <ComboBox x:Name="BoostCombo" Style="{StaticResource FluentComboBox}" DisplayMemberPath="Label" SelectionChanged="BoostCombo_SelectionChanged"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Максимальная мощность"/>
                    <ComboBox x:Name="MaxProcessorCombo" Style="{StaticResource FluentComboBox}"/>

                    <TextBlock Style="{StaticResource FieldHeader}" Text="Энергоэффективность"/>
                    <ComboBox x:Name="EppCombo" Style="{StaticResource FluentComboBox}"/>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Удалить" Style="{StaticResource StandardButton}" Click="DeleteProfile_Click"/>
                        <Button Grid.Column="2" Content="Применить" Style="{StaticResource AccentButton}" Click="ApplyProfile_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== Страница создания профиля ========== -->
            <StackPanel x:Name="AddPage" Grid.Row="0" Margin="24,16,24,20" Visibility="Collapsed">
                <StackPanel.RenderTransform>
                    <TranslateTransform/>
                </StackPanel.RenderTransform>
                <Grid Margin="-8,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SubtleButton}" ToolTip="Назад" Click="Back_Click">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" FontSize="12"/>
                    </Button>
                    <TextBlock Grid.Column="1" Style="{StaticResource TitleText}" Text="Новый профиль" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Style="{StaticResource FieldHeader}" Text="Название"/>
                <TextBox x:Name="ProfileNameBox" Style="{StaticResource FluentTextBox}" KeyDown="ProfileNameBox_KeyDown"/>
                <TextBlock Style="{StaticResource CaptionText}"
                           Text="В профиль будут записаны текущие настройки системы. Их можно будет изменить после создания."
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>

                <Button Content="Создать" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" MinWidth="120" Margin="0,20,0,0" Click="AddProfile_Click"/>
            </StackPanel>

            <!-- ========== Страница автопереключения ========== -->
            <StackPanel x:Name="SettingsPage" Grid.Row="0" Margin="24,16,24,20" Visibility="Collapsed">
                <StackPanel.RenderTransform>
                    <TranslateTransform/>
                </StackPanel.RenderTransform>
                <Grid Margin="-8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SubtleButton}" ToolTip="Назад" Click="Back_Click">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" FontSize="12"/>
                    </Button>
                    <TextBlock Grid.Column="1" Style="{StaticResource TitleText}" Text="Автопереключение" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Style="{StaticResource CaptionText}"
                           Text="Профиль применяется сам, когда меняется источник питания или заряд опускается до порога. Выбранный вручную профиль действует до следующего такого события."
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>

                <TextBlock Style="{StaticResource FieldHeader}" Text="При работе от сети"/>
                <ComboBox x:Name="AcProfileCombo" Style="{StaticResource FluentComboBox}"/>

                <TextBlock Style="{StaticResource FieldHeader}" Text="При работе от батареи"/>
                <ComboBox x:Name="BatteryProfileCombo" Style="{StaticResource FluentComboBox}"/>

                <TextBlock Style="{StaticResource FieldHeader}" Text="При низком заряде"/>
                <ComboBox x:Name="LowBatteryProfileCombo" Style="{StaticResource FluentComboBox}"/>

                <TextBlock Style="{StaticResource FieldHeader}" Text="Низкий заряд — это"/>
                <ComboBox x:Name="LowBatteryThresholdCombo" Style="{StaticResource FluentComboBox}"/>
            </StackPanel>

            <!-- Строка состояния (результат последнего действия) -->
            <TextBlock Grid.Row="1"
                       x:Name="StatusText"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="24,0,24,16"
                       Visibility="Collapsed"/>

            <!-- Нижняя панель, как у быстрых настроек Windows -->
            <Border Grid.Row="2"
                    Height="48"
                    Background="{DynamicResource FooterBackground}"
                    BorderBrush="{DynamicResource DividerStroke}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="24,0,16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BatteryIcon" Style="{StaticResource IconText}" FontSize="16"/>
                    <TextBlock Grid.Column="1" x:Name="BatteryLabel" Style="{StaticResource BodyText}" FontSize="12" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" x:Name="PowerLabel" Style="{StaticResource BodyText}" FontSize="12" Margin="8,0,8,0"/>
                    <Button Grid.Column="3" Style="{StaticResource SubtleButton}" ToolTip="Автопереключение профилей" Click="Settings_Click">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
