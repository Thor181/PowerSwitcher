<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная тема в цветах Windows 11 (WinUI) -->
    <SolidColorBrush x:Key="FlyoutFallbackBackground" Color="#FF202020"/>
    <SolidColorBrush x:Key="PopupBackground" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="PopupStroke" Color="#33000000"/>
    <SolidColorBrush x:Key="FooterBackground" Color="#26000000"/>
    <SolidColorBrush x:Key="DividerStroke" Color="#15FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#5DFFFFFF"/>

    <SolidColorBrush x:Key="ControlFill" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillHover" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillPressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillInputActive" Color="#B31E1E1E"/>
    <SolidColorBrush x:Key="ControlStroke" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrongStroke" Color="#8BFFFFFF"/>

    <SolidColorBrush x:Key="SubtleFillHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillPressed" Color="#0AFFFFFF"/>

    <SolidColorBrush x:Key="ToggleOffFill" Color="#19000000"/>
    <SolidColorBrush x:Key="ToggleOffFillHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ToggleOffKnob" Color="#C5FFFFFF"/>

    <SolidColorBrush x:Key="SliderRail" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="SliderThumbOuter" Color="#FF454545"/>

    <SolidColorBrush x:Key="ScrollThumb" Color="#8BFFFFFF"/>

</ResourceDictionary>
